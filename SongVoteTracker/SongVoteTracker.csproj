<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="SongVoteTracker.csproj.user" Condition="Exists('SongVoteTracker.csproj.user')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
    <FrameworkPathOverride>$(BeatSaberDir)\Beat Saber_Data\Managed</FrameworkPathOverride>
    <MarkPackageReferencesAsExternallyResolved>false</MarkPackageReferencesAsExternallyResolved>
  </PropertyGroup>

  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0436</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Menu\settings.bsml" />
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="Assets\ThumbsDown.png" />
    <EmbeddedResource Include="Assets\ThumbsUp.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SongVoteTracker.csproj.user" Condition="Exists('SongVoteTracker.csproj.user')" />
    <None Include="$(BeatSaberDir)\Logs\_latest.log" Condition="Exists('$(BeatSaberDir)\Logs\_latest.log')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BeatmapCore">
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatSaber.ViewSystem">
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatSaverVoting">
      <HintPath>$(BeatSaberDir)\Plugins\BeatSaverVoting.dll</HintPath>
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="BSML">
      <HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath>
    </Reference>
    <Reference Include="DataModels">
      <Private>false</Private>
    </Reference>
    <Reference Include="DiTails">
      <HintPath>$(BeatSaberDir)\Plugins\DiTails.dll</HintPath>
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="Hive.Versioning">
      <HintPath>$(BeatSaberDir)\Libs\Hive.Versioning.dll</HintPath>
    </Reference>
    <Reference Include="HMUI">
      <Private>false</Private>
    </Reference>
    <Reference Include="Interactable">
      <Private>false</Private>
    </Reference>
    <Reference Include="IPA.Loader">
      <Private>false</Private>
    </Reference>
    <Reference Include="Main">
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(BeatSaberDir)\Libs\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <Reference Include="mscorlib" />
    <Reference Include="netstandard" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="SiraUtil">
      <HintPath>$(BeatSaberDir)\Plugins\SiraUtil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SongCore">
      <HintPath>$(BeatSaberDir)\Plugins\SongCore.dll</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="Unity.TextMeshPro" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.ImageConversionModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" />
    <Reference Include="UnityEngine.UIElementsModule" />
    <Reference Include="UnityEngine.UIModule" />
    <Reference Include="Zenject">
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>